            "description": "Page number for pagination"
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "description": "Number of items per page"
          },
          {
            "in": "query",
            "name": "contactId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter conversations by contact ID"
          },
          {
            "in": "query",
            "name": "agentId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter conversations by agent ID"
          },
          {
            "in": "query",
            "name": "identifier",
